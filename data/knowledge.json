[
 {
  "id": "muscle-fat-ratio",
  "date": "2026-11-13",
  "title": "脂肪与肌肉减少的关键因素",
  "tags": [
   "体成分",
   "蛋白质",
   "抗阻训练",
   "睡眠"
  ],
  "summary": "核心结论:保肌肉靠四件事——蛋白 1.6g/kg+、抗阻训练每周 2-3 次、缺口别超 1%/周、睡眠 7h+。证据见正文。",
  "body": [
   {
    "h": "核心结论:应该做什么",
    "p": "把瘦体重损失从「常规节食的 25~35%」压到接近 0,四个杠杆按证据强度排序:",
    "table": {
     "headers": [
      "优先级",
      "做什么",
      "剂量",
      "证据效果"
     ],
     "rows": [
      [
       "1",
       "蛋白质",
       "1.6~2.2g/kg(现体重约 140g/天),分 3~4 餐,每餐 ≥30g",
       "瘦体重损失占比 25~35% → ~11%,最强单一饮食杠杆"
      ],
      [
       "2",
       "抗阻训练",
       "每周 2~3 次,每肌群 4~8 组,2-3 RIR,居家自重即可",
       "唯一的「净增肌」干预;不练 vs 练,瘦体重结局差 3.6kg"
      ],
      [
       "3",
       "缺口速率",
       "减重 ≤1% 体重/周",
       ">1%/周时肌肉流失显著加速"
      ],
      [
       "4",
       "睡眠",
       "≥7 小时",
       "5.5h vs 8.5h:多丢 60% 肌肉、少减 55% 脂肪"
      ]
     ]
    }
   },
   {
    "h": "变量谱系:干预方式决定瘦体重损失占比",
    "p": "下图是各干预条件下,减掉的体重里瘦体重占的比例(越低越好)。注意:饮食结构(生酮 vs 低脂)几乎不改变比例;真正强变量只有蛋白量、抗阻、缺口速率、睡眠四个。"
   },
   {
    "chart": "kbChart-spectrum"
   },
   {
    "h": "关键实验:Longland 2016 (AJCN, PMID 26817506)",
    "p": "40 名男性,40% 大缺口(约-32%维持热量)+每周6天高强度运动,随机分高蛋白组(2.4g/kg)与对照组(1.2g/kg),4周。结果:高蛋白组瘦体重 +1.2kg、脂肪 -4.8kg;对照组瘦体重 +0.1kg、脂肪 -3.5kg。意义:大缺口+大运动量下,蛋白量是「掉肌肉还是增肌肉」的分水岭;但该方案运动量极大,普通减脂场景不可直接照搬。"
   },
   {
    "chart": "kbChart-longland"
   },
   {
    "h": "关键实验:PMC12851882 (运动方式对照)",
    "p": "热量缺口下分组对照:无运动组瘦体重损失占减重 33.9%(男)/23.5%(女);有氧组 -1.1kg(男);抗阻组瘦体重净增 +0.8~1.15kg,且 85% 的抗阻参与者瘦体重不降反增,无人瘦体重损失超过体重 15%。对照组文献口径:81% 的纯饮食者瘦体重损失≥体重 15%。意义:同样的热量缺口,运动方式本身就把结果分成三个世界。"
   },
   {
    "chart": "kbChart-exercise"
   },
   {
    "h": "关键实验:Nedeltcheva 2010 (睡眠与体成分)",
    "p": "同热量缺口(-10%)、同蛋白摄入下,睡眠 5.5h 组 vs 8.5h 组,14天:5.5h 组脂肪减少 55% 更少、瘦体重丢失多 60%;且饥饿素上升、感知饱腹下降。机制:睡眠剥夺 → 皮质醇升、睾酮降、MPS 降 18%(Lamon 2021 单晚剥夺实验)。意义:睡眠不是休息问题,是体成分分配的独立变量。"
   },
   {
    "chart": "kbChart-sleep"
   },
   {
    "h": "关键实验:Helms 等蛋白需求综述",
    "p": "减脂期蛋白需求高于维持量。RDA 0.8g/kg 在缺口下显著不足:",
    "table": {
     "headers": [
      "摄入量",
      "定位",
      "说明"
     ],
     "rows": [
      [
       "0.8g/kg",
       "RDA(不运动人群的最低线)",
       "缺口下明显不足"
      ],
      [
       "1.2~1.4g/kg",
       "普通减脂的及格线",
       "能减少但压不到最优"
      ],
      [
       "1.6~2.2g/kg",
       "减脂保肌推荐区间(Helms 2014 等)",
       "证据最充分,边际收益最高"
      ],
      [
       "≥2.4g/kg",
       "上限",
       "无额外保肌收益(Longland 2.4 vs 1.6 不再显著放大)"
      ],
      [
       "分布",
       "每餐 ≥0.4g/kg、3~4 餐",
       "持续越过 leucine 阈值刺激 MPS,比总量次重要"
      ]
     ]
    }
   },
   {
    "h": "缺口速率的阈值效应",
    "p": "减重速率 >1% 体重/周:瘦体重流失比例显著上升(运动员数据,Garthe 2011:慢减组增肌 0.9%、快减组掉瘦体重)。机制:缺口越大,MPS 抑制越深,膳食蛋白被氧化供能的比例越高。经验阈值:每周 0.5~1% 体重是「保肌窗口」。"
   },
   {
    "h": "测量:BIA 体脂秤的系统性偏差",
    "table": {
     "headers": [
      "现象",
      "原因",
      "应对"
     ],
     "rows": [
      [
       "日波动 ±0.3~0.5kg(极差可达 1.5kg)",
       "对水分极敏感:1g 糖原携带 3g 水",
       "只看 7 日均值趋势,单日跳动无信息量"
      ],
      [
       "减脂初期肌肉量「暴跌」",
       "前 2 周掉的是糖原+水,不是肌纤维",
       "奠基期数据不作为任何基准"
      ],
      [
       "真实肌纤维损失被高估",
       "BIA 把水分流失算进瘦体重",
       "按月度量级评估:无训练+高蛋白 ≈ -0.1~-0.3kg/月"
      ]
     ]
    }
   }
  ],
